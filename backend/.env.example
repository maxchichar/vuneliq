APP_NAME="Vuneliq API"
ENVIRONMENT="development"
DEBUG=true

# sqlite for dev, change to postgres in production
DATABASE_URL="sqlite:///./vuneliq.db"
SECRET_KEY="replace-with-a-secure-random-secret"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
# AI: leave AI_API_KEY empty to use the mock provider
AI_API_KEY=""
AI_MODEL=""
AI_MAX_INPUT_CHARS=500
AI_RATE_LIMIT_PER_MINUTE=5
AI_RATE_LIMIT_PER_DAY=50
